# =============================================================================
# Castúo — Robotics lab stub + admin general (Hetzner / VPS / producción)
# Copiar a .env fuera del repositorio. NUNCA valores reales en git.
# Trazabilidad: Opción A/B/C = matriz única en backend/security/VAULT_KV_PATHS.md
# TRL6 edge: docs/deploy/CHECKLIST-TRL6-HETZNER-STAGING.md
# =============================================================================

# -----------------------------------------------------------------------------
# Opción A: Docker Secrets (recomendado producción)
# El nombre del secret en Swarm debe coincidir con el basename de la ruta montada.
#   docker secret create castuo_admin_general_bearer ./secrets/admin_general.bearer
#   docker secret create robotics_lab_bearer ./secrets/robotics_lab.bearer
# -----------------------------------------------------------------------------
CASTUO_ADMIN_GENERAL_BEARER_FILE=/run/secrets/castuo_admin_general_bearer
CASTUO_ROBOTICS_LAB_BEARER_TOKEN_FILE=/run/secrets/robotics_lab_bearer
# GAIA_CHAIN_PRIVATE_KEY_FILE=/run/secrets/castuo_gaia_private_key
# ADMIN_MASTER_KEY_FILE=/run/secrets/castuo_admin_master_key

# -----------------------------------------------------------------------------
# Opción B: Vault KV v2 (alternativo; hvac opcional en proceso que lea antes de escribir ficheros)
# Token vía fichero = mismo patrón que A (no pegar token en .env versionado).
# -----------------------------------------------------------------------------
# VAULT_ADDR=https://vault.castuo.local:8200
# VAULT_TOKEN_FILE=/run/secrets/vault_token
# (solo si inyectas token en env efímera, no en archivo:)
# VAULT_TOKEN=

# Rutas KV: ver backend/security/VAULT_KV_PATHS.md y backend/security/vault.py

# -----------------------------------------------------------------------------
# NO Opción C: valores directos en .env — solo dev local, comentado; prohibido prod
# auth_roles.read_secret("CASTUO_ADMIN_GENERAL_BEARER") lee env o *_FILE, no un literal "..._FILE".
# -----------------------------------------------------------------------------
# CASTUO_ADMIN_GENERAL_BEARER=
# CASTUO_ROBOTICS_LAB_BEARER_TOKEN=

# --- Lab ---
CASTUO_ROBOTICS_LAB=0
CASTUO_NEUROMORPHIC_LAB=0
CASTUO_ECO_ALLOY=Cs2AgBiBr6

# --- Cadena opt-in (mismas vars que backend/api/config.py) ---
CASTUO_ROBOTICS_LAB_CHAIN_REGISTER=0
CASTUO_ROBOTICS_LAB_CHAIN_TOKEN_ID=0
CASTUO_ROBOTICS_LAB_CHAIN_INCLUDE_PARCEL_ID=0
# GAIA_CHAIN_RPC=https://...
# GAIA_CHAIN_AUDIT_CONTRACT=0x...
# GAIA_CHAIN_AUDIT_ABI=[...]

# Health (sin Bearer): curl -sS https://tu-host/health | jq .chain_status
# Playbook admin: curl -sS -H "Authorization: Bearer $(cat /run/secrets/castuo_admin_general_bearer)" \
#   https://tu-host/admin_general/playbook | jq .

# Compose: docker compose -f docker-compose.scan3d.yml --env-file .env.hetzner up -d

