# Copiar a .env.cerebros → docker compose -f docker-compose.cerebros.yml --env-file .env.cerebros up -d
# Ver n8n/README-CEREBROS.md (Logseq HTTPS remoto, integración n8n, límites de Anytype).

# Logseq web (solo localhost por defecto; puerto interno del contenedor 80)
LOGSEQ_PORT=3001

# SilverBullet — formato usuario:contraseña (obligatorio)
CEREBRO_SOBERANO_SB_USER=admin:cambia_esta_clave
CEREBRO_AUDITOR_SB_USER=admin:cambia_esta_clave_otra
# Opcional: token Bearer para API programática (documentación: silverbullet.md → Authentication / API)
CEREBRO_SOBERANO_SB_AUTH_TOKEN=
CEREBRO_AUDITOR_SB_AUTH_TOKEN=

SILVERBULLET_SOBERANO_PORT=3002
SILVERBULLET_AUDITOR_PORT=3003

# Postgres dedicado a este compose (evita choque con 5432 del stack principal)
CEREBROS_POSTGRES_DB=agri_brain
CEREBROS_POSTGRES_USER=agri_brain
CEREBROS_POSTGRES_PASSWORD=cambia_password_fuerte
CEREBROS_POSTGRES_PORT=5433
