# =============================================
# .env.cloud.example - Perfiles cloud soberanos (UE)
# =============================================

# --- Entorno ---
ENV=staging
CLOUD_PROVIDER=hetzner

# --- Core API ---
API_PORT=8000
API_REPLICAS=3
API_CPU_LIMIT=2.0
API_MEM_LIMIT=4G
API_HEALTH_PATH=/health
ALLOWED_ORIGINS=https://castuo-system.cloud,https://n8n.castuo-system.cloud

# --- Persistencia/Core ---
POSTGRES_PASSWORD=changeme_use_strong_password
N8N_USER=admin
N8N_PASSWORD=changeme_use_strong_password
WEBHOOK_URL=https://n8n.castuo-system.cloud

# --- Observabilidad ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_use_strong_password
S3_BUCKET_LOGS=castuo-system-logs-staging
AWS_DEFAULT_REGION=eu-central-1

# --- IoT ---
IOT_NETWORK_NAME=iot_network_cloud
IOT_TELEMETRY_URL=https://api.castuo-system.cloud/api/v1/iot/telemetry
IOT_DEVICE_CMD_URL=https://api.castuo-system.cloud/api/v1/devices/command
TRACES_HYPERLEDGER_URL=https://traces.castuo-system.cloud/hyperledger

# --- Wireless Logic IoT Backbone (Conexa EU) ---
# Leave WIRELESS_LOGIC_MQTT_HOST empty to disable upstream bridge (local-only mode)
WIRELESS_LOGIC_MQTT_HOST=
WIRELESS_LOGIC_MQTT_PORT=8883
# Token file must be present at ./secrets/wireless_logic_token on the host
# WIRELESS_LOGIC_API_TOKEN_FILE is injected by compose from secrets/wireless_logic_token

# MQTT local broker settings
MQTT_PORT=1883
MQTT_USERNAME=castuo
MQTT_TOPIC_PREFIX=castuo/sensors

# --- AI / Sabionda / Gaia-X ---
AI_ENGINE=mistral-large-latest
GAIA_X_RPC=https://rpc.gaia-x.cloud
OPENCLAW_SOVEREIGN_MODE=strict
OPENCLAW_DATA_RESIDENCY=eu-only
OPENCLAW_ALLOWED_REGION=eu-*
OPENCLAW_POLICY_PROFILE=sabionda-eu
OPENCLAW_ENDPOINT=https://openclaw.castuo-system.cloud

# --- Skills validar_lote (GaiaChain real) ---
GAIACHAIN_RPC_URL=https://gaiachain.castuo-system.cloud/rpc
# Solo para pruebas locales. En produccion usar fichero secreto montado.
GAIACHAIN_PRIVATE_KEY=
JWT_SECRET_KEY=changeme_jwt_secret

# --- Secrets via files (recommended) ---
VAULT_ADDR=https://vault.castuo-system.cloud:8200
VAULT_TOKEN_FILE=/run/secrets/vault_token
# MISTRAL_API_KEY_FILE and SABIONDA_API_KEY_FILE are injected by compose from secrets

# --- Local secret files in host for docker compose ---
# ./secrets/vault_token
# ./secrets/iot_bearer
# ./secrets/wireless_logic_token   (leave empty file if not connecting to WL)
# ./secrets/mistral_key
# ./secrets/sabionda_key
