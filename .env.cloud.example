# CASTUO-SYSTEM cloud profile (copy to .env.cloud)
# cp .env.cloud.example .env.cloud

# --- Profile selector ---
ENV=staging
CLOUD_PROVIDER=hetzner

# Core API
API_PORT=8000
API_REPLICAS=3
API_CPU_LIMIT=2.0
API_MEM_LIMIT=4G
API_HEALTH_PATH=/health

# Sovereign EU stack
AWS_DEFAULT_REGION=eu-central-1
S3_BUCKET_LOGS=castuo-system-logs-staging
VAULT_ADDR=https://vault.castuo-system.cloud:8200
VAULT_TOKEN_FILE=/run/secrets/vault_token
VAULT_DEV_ROOT_TOKEN_ID=castuo-dev-root-token
VAULT_PORT=8200

# AI + governance
MISTRAL_API_URL=https://api.mistral.ai
AI_ENGINE=mistral-large-latest

# IoT universal connectivity
IOT_NETWORK_NAME=iot_network_cloud
IOT_TELEMETRY_URL=https://api.castuo-system.cloud/api/v1/iot/telemetry
IOT_DEVICE_CMD_URL=https://api.castuo-system.cloud/api/v1/devices/command
CASTUO_IOT_TIMEOUT_S=30
CASTUO_IOT_BEARER_FILE=/run/secrets/iot_bearer

# Chain observability
CASTUO_ROBOTICS_LAB_CHAIN_REGISTER=0
GAIA_X_RPC=https://rpc.gaia-x.cloud
GAIA_CHAIN_AUDIT_CONTRACT=
CASTUO_NEUROMORPHIC_LAB=1

# CORS
ALLOWED_ORIGINS=https://castuo-system.cloud,https://n8n.castuo-system.cloud

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
MQTT_PORT=1883
MQTTS_PORT=8883
MQTT_TOPIC=castuo/sensors/#
MQTT_BROKER=iot-bridge
AI_PORT=8010
TRACES_HYPERLEDGER_URL=

# Wireless Logic / Conexa EU backbone
WIRELESS_LOGIC_MQTT_HOST=mqtt.conexa.wirelesslogic.com
WIRELESS_LOGIC_MQTT_USER=
WIRELESS_LOGIC_MQTT_PASS=

# Secrets expected as files:
# - ./secrets/vault_token
# - ./secrets/iot_bearer
# - ./secrets/mistral_key
# - ./secrets/sabionda_key
# - ./secrets/wireless_logic_token
