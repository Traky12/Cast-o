# CASTÚO-SYSTEM™ v2.0 — Alertas con contexto normativo
# Cargar en Prometheus: rule_files: - "alert.rules"

groups:
  - name: castuo-system-alerts
    rules:
      - alert: HighCPUUsage
        expr: 100 - (avg(rate(node_cpu_seconds_total{mode="idle"}[1m])) * 100) > 80
        for: 5m
        labels:
          severity: critical
          normative: "ISO_27001:A.12.4.1"
          team: devops
        annotations:
          summary: "Uso de CPU > 80% (ISO 27001:A.12.4.1)"
          description: "Uso de CPU > 80% durante 5 minutos. Normativa: ISO 27001:A.12.4.1 (Monitorización de recursos)."
          runbook_url: "https://docs.castuo-system.eu/alerts/high_cpu"

      - alert: HighMemoryUsage
        expr: (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100 > 90
        for: 5m
        labels:
          severity: critical
          normative: "ISO_27001:A.12.4.1"
          team: devops
        annotations:
          summary: "Uso de memoria > 90% (ISO 27001:A.12.4.1)"
          description: "Uso de memoria > 90% durante 5 minutos."
          runbook_url: "https://docs.castuo-system.eu/alerts/high_memory"

      - alert: HighErrorRate
        expr: (rate(http_requests_total{status=~"5.."}[1m]) / rate(http_requests_total[1m])) > 0.05
        for: 2m
        labels:
          severity: critical
          normative: "NIS2:Art.23"
          team: backend
        annotations:
          summary: "Tasa de errores > 5% (NIS2:Art.23)"
          description: "Tasa de errores HTTP > 5%. Normativa: NIS2 Art. 23 (Gestión de incidentes)."
          runbook_url: "https://docs.castuo-system.eu/alerts/high_error_rate"

      - alert: SelfHealingTriggered
        expr: increase(self_healing_events_total[1m]) > 0
        labels:
          severity: warning
          normative: "ISO_27001:A.16.1.1"
          team: devops
        annotations:
          summary: "Evento de auto-reparación (ISO 27001:A.16.1.1)"
          description: "El agente de auto-reparación ha sido activado. Revisar logs en /var/log/castuo/selfhealing.log."
