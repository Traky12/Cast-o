{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "CASTÚO-SYSTEM API v3.1",
  "uid": "castuo-api-v31",
  "tags": ["castuo", "api", "kubernetes"],
  "timezone": "Europe/Madrid",
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Pods en ejecución",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "count(kube_pod_status_phase{namespace=\"castuo-system\",pod=~\"castuo-api.*\",phase=\"Running\"})",
        "legendFormat": "Pods Running"
      }],
      "options": { "colorMode": "background", "thresholds": { "steps": [
        { "value": 0, "color": "red" },
        { "value": 2, "color": "yellow" },
        { "value": 3, "color": "green" }
      ]}}
    },
    {
      "id": 2,
      "title": "CPU Usage (%)",
      "type": "gauge",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "avg(rate(container_cpu_usage_seconds_total{namespace=\"castuo-system\",container=\"castuo-api\"}[5m])) * 100",
        "legendFormat": "CPU %"
      }],
      "options": { "thresholds": { "steps": [
        { "value": 0, "color": "green" },
        { "value": 70, "color": "yellow" },
        { "value": 90, "color": "red" }
      ]}}
    },
    {
      "id": 3,
      "title": "Memory Usage (MB)",
      "type": "gauge",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "avg(container_memory_working_set_bytes{namespace=\"castuo-system\",container=\"castuo-api\"}) / 1024 / 1024",
        "legendFormat": "RAM MB"
      }],
      "options": { "thresholds": { "steps": [
        { "value": 0, "color": "green" },
        { "value": 384, "color": "yellow" },
        { "value": 490, "color": "red" }
      ]}}
    },
    {
      "id": 4,
      "title": "Réplicas HPA",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"castuo-system\",horizontalpodautoscaler=\"castuo-api-hpa\"}",
        "legendFormat": "Réplicas actuales"
      }],
      "options": { "colorMode": "value" }
    },
    {
      "id": 5,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"castuo-system\"}[2m])) by (path)",
          "legendFormat": "{{ path }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 6,
      "title": "Latencia p50/p95/p99 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{namespace=\"castuo-system\"}[5m])) * 1000",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{namespace=\"castuo-system\"}[5m])) * 1000",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{namespace=\"castuo-system\"}[5m])) * 1000",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 7,
      "title": "HTTP Errors (4xx + 5xx)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"castuo-system\",status=~\"4..\"}[5m])) by (path)",
          "legendFormat": "4xx {{ path }}"
        },
        {
          "expr": "sum(rate(http_requests_total{namespace=\"castuo-system\",status=~\"5..\"}[5m])) by (path)",
          "legendFormat": "5xx {{ path }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "fixedColor": "red", "mode": "fixed" } } }
    },
    {
      "id": 8,
      "title": "Transacciones GaiaChain / hora",
      "type": "stat",
      "gridPos": { "x": 12, "y": 12, "w": 6, "h": 6 },
      "targets": [{
        "expr": "increase(castuo_blockchain_transactions_total{namespace=\"castuo-system\"}[1h])",
        "legendFormat": "TX/h"
      }],
      "options": { "colorMode": "background", "thresholds": { "steps": [
        { "value": 0, "color": "blue" }
      ]}}
    },
    {
      "id": 9,
      "title": "Lotes validados / hora",
      "type": "stat",
      "gridPos": { "x": 18, "y": 12, "w": 6, "h": 6 },
      "targets": [{
        "expr": "increase(castuo_lotes_validados_total{namespace=\"castuo-system\"}[1h])",
        "legendFormat": "Lotes/h"
      }],
      "options": { "colorMode": "background", "thresholds": { "steps": [
        { "value": 0, "color": "green" }
      ]}}
    },
    {
      "id": 10,
      "title": "Estado de Pods (últimas 3h)",
      "type": "table",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 6 },
      "targets": [{
        "expr": "kube_pod_info{namespace=\"castuo-system\",pod=~\"castuo-api.*\"}",
        "legendFormat": "",
        "instant": true,
        "format": "table"
      }],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "__name__": true, "job": true }, "indexByName": {} } }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
