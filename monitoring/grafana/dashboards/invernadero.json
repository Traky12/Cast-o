{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "InfluxDB invernadero",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    },
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "CASTÚO — Invernadero Agrovoltaico Hidropónico",
  "uid":  "castuo-invernadero-v1",
  "version": 1,
  "schemaVersion": 37,
  "refresh": "30s",
  "tags": ["castuo", "invernadero", "hidroponia", "agrovoltaico"],
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "zona",
        "type": "query",
        "label": "Zona",
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"invernadero_sensores\", tag: \"zona\")",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "cultivo",
        "type": "query",
        "label": "Cultivo",
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"invernadero_sensores\", tag: \"cultivo\")",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Temperatura Aire (°C)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"invernadero_sensores\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"clima\" and r._field == \"temp_aire_c\")\n  |> filter(fn: (r) => contains(value: r.zona, set: ${zona:json}))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",  "value": null },
              { "color": "green", "value": 18 },
              { "color": "yellow","value": 28 },
              { "color": "red",   "value": 32 }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": 60000
          }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 2,
      "title": "Humedad Relativa (%)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"invernadero_sensores\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"clima\" and r._field == \"humedad_relativa_pct\")\n  |> filter(fn: (r) => contains(value: r.zona, set: ${zona:json}))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow","value": null },
              { "color": "green", "value": 40 },
              { "color": "yellow","value": 80 },
              { "color": "red",   "value": 85 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "CO₂ (ppm)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"invernadero_sensores\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"clima\" and r._field == \"co2_ppm\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 600 },
              { "color": "yellow","value": 1200 },
              { "color": "red",   "value": 2000 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "pH Solución Nutritiva",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 8, "w": 4, "h": 6 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"invernadero_sensores\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"solucion_nutritiva\" and r._field == \"ph\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 4.0, "max": 8.5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "yellow","value": 5.0 },
              { "color": "green", "value": 5.5 },
              { "color": "yellow","value": 6.5 },
              { "color": "red",   "value": 7.5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": true }
    },
    {
      "id": 5,
      "title": "EC Solución (mS/cm)",
      "type": "gauge",
      "gridPos": { "x": 4, "y": 8, "w": 4, "h": 6 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"invernadero_sensores\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"solucion_nutritiva\" and r._field == \"ec_ms_cm\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0, "max": 6,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "yellow","value": 0.8 },
              { "color": "green", "value": 1.5 },
              { "color": "yellow","value": 4.0 },
              { "color": "red",   "value": 5.0 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true }
    },
    {
      "id": 6,
      "title": "O₂ Disuelto (mg/L)",
      "type": "gauge",
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 6 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"invernadero_sensores\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"solucion_nutritiva\" and r._field == \"o2_disuelto_mg_l\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0, "max": 20,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "orange","value": 4.0 },
              { "color": "yellow","value": 6.0 },
              { "color": "green", "value": 8.0 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true }
    },
    {
      "id": 7,
      "title": "VPD (kPa)",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 8, "w": 4, "h": 6 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"invernadero_sensores\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"clima\" and r._field == \"vpd_kpa\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pressurehpa",
          "min": 0, "max": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",  "value": null },
              { "color": "green", "value": 0.4 },
              { "color": "yellow","value": 1.5 },
              { "color": "red",   "value": 2.0 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 8,
      "title": "Potencia Solar Generada (W)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"invernadero_energia\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"agrovoltaico\" and r._field == \"potencia_w\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        },
        {
          "refId": "B",
          "query": "from(bucket: \"invernadero_energia\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"agrovoltaico\" and r._field == \"kwh_hoy\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)",
          "alias": "kWh hoy (acumulado)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "watt", "custom": { "lineWidth": 2, "fillOpacity": 20 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "kWh hoy (acumulado)" }, "properties": [{ "id": "unit", "value": "kwatth" }] }
        ]
      }
    },
    {
      "id": 9,
      "title": "Temperatura Panel Solar (°C)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"invernadero_energia\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"agrovoltaico\" and r._field == \"temperatura_panel_c\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow","value": 60 },
              { "color": "red",   "value": 75 }
            ]
          },
          "custom": { "lineWidth": 2, "thresholdsStyle": { "mode": "line" } }
        }
      }
    },
    {
      "id": 10,
      "title": "Estado Actuadores",
      "type": "table",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"invernadero_actuadores\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"actuador_evento\")\n  |> last()\n  |> group(columns: [\"actuador\", \"zona\", \"accion\", \"triggered_by\"])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "displayMode": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "accion" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "encender": { "color": "green", "index": 0 }, "apagar": { "color": "red", "index": 1 }, "ajustar": { "color": "blue", "index": 2 }, "pulso": { "color": "yellow", "index": 3 } } }
              ]}
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 11,
      "title": "Eventos de Actuación (últimas 3h)",
      "type": "logs",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"invernadero_actuadores\")\n  |> range(start: -3h)\n  |> filter(fn: (r) => r._measurement == \"actuador_evento\")\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 100)"
        }
      ],
      "options": { "showTime": true, "showLabels": true, "sortOrder": "Descending" }
    },
    {
      "id": 12,
      "title": "Alertas Activas del Sistema",
      "type": "alertlist",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "alertName": "",
        "dashboardAlerts": false,
        "groupBy": ["alertname", "zona"],
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 3,
        "stateFilter": { "firing": true, "pending": true, "noData": false, "normal": false, "error": false },
        "tags": ["invernadero"]
      }
    }
  ]
}
