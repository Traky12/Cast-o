# Copiar a https-server.conf (o descomentar en default.conf) cuando ya tengas certificados.
# Let's Encrypt no emite certs para IP; usa un dominio (ej. castuo-system.com).

server {
    listen 443 ssl http2;
    server_name 89.167.5.233 castuo-system.com *.castuo-system.com;

    ssl_certificate /etc/letsencrypt/live/castuo-system.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/castuo-system.com/privkey.pem;

    location /api/ {
        proxy_pass http://api:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html dronica.html;
        try_files $uri $uri/ /index.html;
    }
}
