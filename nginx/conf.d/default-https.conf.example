# HTTPS (activar cuando ya tengas certificados)
# 1. Copia este contenido sobre default.conf, o incluye este fichero como default-https.conf
#    (renombrando a default-https.conf para que nginx lo cargue).
# 2. Reinicia: docker-compose restart frontend

# Server 80 → Certbot + redirect a HTTPS
server {
    listen 80;
    server_name castuo-system.com 89.167.5.233;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Server 443
server {
    listen 443 ssl http2;
    server_name castuo-system.com 89.167.5.233;

    ssl_certificate /etc/letsencrypt/live/castuo-system.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/castuo-system.com/privkey.pem;

    location /api/ {
        proxy_pass http://api:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
