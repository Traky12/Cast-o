# CASTÚO BookStack — Variables de entorno (copiar a .env y rellenar)
# No commitear .env con valores reales.

# URL pública (Hetzner: https://bookstack.tudominio.com o https://tu-ip:8080)
BOOKSTACK_APP_URL=https://bookstack.castuo.local
BOOKSTACK_PORT=8080

# Usuario/grupo del host (Linux)
PUID=1000
PGID=1000

# Base de datos MariaDB (generar en prod: openssl rand -base64 32 → DB_PASS; openssl rand -base64 48 → ROOT)
BOOKSTACK_DB_PASS=TuPassw0rdSeguro!
MARIADB_ROOT_PASSWORD=RootPassw0rd2026!
