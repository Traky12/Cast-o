# Copiar a .env.remote-access en la raíz del repo (o usar --env-file)

KEYCLOAK_ADMIN_PASSWORD=change-me-strong
KEYCLOAK_DB_PASSWORD=change-me-db-strong

KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=castuo-system
KEYCLOAK_CLIENT_ID=api-gateway
KEYCLOAK_CLIENT_ID_BACKEND=backend

# JWKS debe coincidir con el cliente que firma el token (p. ej. backend o api-gateway)
GATEWAY_AUTH_DISABLED=false
# Si Keycloak emite aud distinto al client_id del gateway, probar false (solo laboratorio).
GATEWAY_VERIFY_AUD=true
BACKEND_AUTH_DISABLED=true

CASTUO_BACKEND_URL=http://backend:8000
# Opcional: uvicorn scripts.ai.mistral_lora.app:app en otro contenedor o host
LORA_UPSTREAM=

REMOTE_HTTP_PORT=8088
REMOTE_HTTPS_PORT=8443
API_GATEWAY_PORT=18000
KEYCLOAK_HOST_PORT=8090
BACKEND_HOST_PORT=8000
MQTT_PLAIN_PORT=1883
MQTT_TLS_PORT=8883

KC_HOSTNAME=localhost

BASTION_SSH_PORT=2222
BASTION_USER=ctaex
