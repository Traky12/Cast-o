<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_castu_alert_rule_tree" model="ir.ui.view">
        <field name="name">castu.alert.rule.tree</field>
        <field name="model">castu.alert.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="material_id"/>
                <field name="metric"/>
                <field name="threshold_type"/>
                <field name="threshold_value"/>
                <field name="severity"/>
                <field name="action"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_castu_alert_rule_form" model="ir.ui.view">
        <field name="name">castu.alert.rule.form</field>
        <field name="model">castu.alert.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="material_id"/>
                        <field name="metric"/>
                        <field name="threshold_type"/>
                        <field name="threshold_value"/>
                        <field name="window_hours"/>
                        <field name="severity"/>
                        <field name="action"/>
                        <field name="active"/>
                    </group>
                </sheet>
                <footer>
                    <button name="evaluate" string="Evaluar Regla" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_castu_alert_rule" model="ir.actions.act_window">
        <field name="name">Reglas de Alertas</field>
        <field name="res_model">castu.alert.rule</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_castu_alert_rules" name="Reglas de Alertas"
        parent="castu_materials.menu_castu_materials_root" action="action_castu_alert_rule" sequence="60"/>
</odoo>
