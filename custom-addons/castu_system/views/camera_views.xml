<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_castu_drone_camera_tree" model="ir.ui.view">
        <field name="name">castu.drone.camera.tree</field>
        <field name="model">castu.drone.camera</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="drone_id"/>
                <field name="rtsp_url"/>
                <field name="estado"/>
                <field name="resolucion"/>
            </tree>
        </field>
    </record>
    <record id="view_castu_drone_camera_form" model="ir.ui.view">
        <field name="name">castu.drone.camera.form</field>
        <field name="model">castu.drone.camera</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="drone_id"/>
                        <field name="rtsp_url"/>
                        <field name="estado"/>
                        <field name="resolucion"/>
                        <field name="fps"/>
                    </group>
                    <group string="Alertas">
                        <field name="alert_ids" nolabel="1">
                            <tree>
                                <field name="tipo"/>
                                <field name="confianza"/>
                                <field name="fecha"/>
                                <field name="resuelta"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_start_stream" string="Iniciar Stream" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_castu_drone_camera" model="ir.actions.act_window">
        <field name="name">Cámaras de Drones</field>
        <field name="res_model">castu.drone.camera</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_castu_drone_cameras" name="Cámaras" parent="menu_castu_drones" action="action_castu_drone_camera" sequence="30"/>
</odoo>
