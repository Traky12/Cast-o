<odoo>
    <record id="view_castu_licencia_tree" model="ir.ui.view">
        <field name="name">castu.licencia.tree</field>
        <field name="model">castu.licencia</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="granja_id"/>
                <field name="fecha"/>
                <field name="rea_numero"/>
                <field name="state"/>
                <field name="biocoin_tx"/>
            </tree>
        </field>
    </record>

    <record id="view_castu_licencia_form" model="ir.ui.view">
        <field name="name">castu.licencia.form</field>
        <field name="model">castu.licencia</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generar_documento" type="object" string="Generar documento" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,registered"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="granja_id"/>
                        <field name="fecha"/>
                        <field name="potencia_kw"/>
                        <field name="rea_numero"/>
                    </group>
                    <group>
                        <field name="documento_ipfs"/>
                        <field name="biocoin_tx"/>
                        <field name="git_commit"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_castu_licencia" model="ir.actions.act_window">
        <field name="name">Licencias</field>
        <field name="res_model">castu.licencia</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_castu_licencias" name="Licencias" parent="menu_castu_root" action="action_castu_licencia" sequence="20"/>
</odoo>

