<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_castu_energia_tree" model="ir.ui.view">
        <field name="name">castu.energia.tree</field>
        <field name="model">castu.energia</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="granja_id"/>
                <field name="tipo"/>
                <field name="potencia_actual"/>
                <field name="energia_generada"/>
                <field name="estado"/>
            </tree>
        </field>
    </record>
    <record id="view_castu_energia_form" model="ir.ui.view">
        <field name="name">castu.energia.form</field>
        <field name="model">castu.energia</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="granja_id"/>
                        <field name="tipo"/>
                        <field name="potencia_actual"/>
                        <field name="energia_generada"/>
                        <field name="estado"/>
                    </group>
                    <group string="Baterías">
                        <field name="bateria_ids" nolabel="1">
                            <tree>
                                <field name="name"/>
                                <field name="capacidad"/>
                                <field name="nivel_actual"/>
                                <field name="estado"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_optimizar_energia" string="Optimizar Energía" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_castu_energia" model="ir.actions.act_window">
        <field name="name">Energía Agrovoltaica</field>
        <field name="res_model">castu.energia</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_castu_energia" name="Energía" parent="menu_castu_root" action="action_castu_energia" sequence="70"/>
</odoo>
