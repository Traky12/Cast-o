<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_castu_material_production_tree" model="ir.ui.view">
        <field name="name">castu.material.production.tree</field>
        <field name="model">castu.material.production</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="material_id"/>
                <field name="date"/>
                <field name="kg_produced"/>
                <field name="state"/>
                <field name="blockchain_tx"/>
            </tree>
        </field>
    </record>
    <record id="view_castu_material_production_form" model="ir.ui.view">
        <field name="name">castu.material.production.form</field>
        <field name="model">castu.material.production</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="material_id"/>
                        <field name="date"/>
                        <field name="kg_produced"/>
                        <field name="raw_material_kg"/>
                        <field name="energy_kwh"/>
                        <field name="operator_id"/>
                        <field name="state"/>
                        <field name="blockchain_tx" readonly="1"/>
                    </group>
                    <group string="Certificaciones">
                        <field name="certification_ids" nolabel="1">
                            <tree>
                                <field name="name"/>
                                <field name="certification_body"/>
                                <field name="date"/>
                                <field name="validity"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_produce" string="Iniciar Producción" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Finalizar Producción" type="object" class="btn-primary" invisible="state != 'producing'"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_castu_material_production" model="ir.actions.act_window">
        <field name="name">Producción</field>
        <field name="res_model">castu.material.production</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_castu_material_production" name="Producción" parent="menu_castu_materials_root" action="action_castu_material_production" sequence="20"/>
</odoo>
