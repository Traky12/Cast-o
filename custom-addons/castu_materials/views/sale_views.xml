<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_castu_material_sale_tree" model="ir.ui.view">
        <field name="name">castu.material.sale.tree</field>
        <field name="model">castu.material.sale</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_castu_material_sale_form" model="ir.ui.view">
        <field name="name">castu.material.sale.form</field>
        <field name="model">castu.material.sale</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="date"/>
                        <field name="partner_id"/>
                        <field name="state"/>
                        <field name="blockchain_tx" readonly="1"/>
                    </group>
                    <group string="Líneas">
                        <field name="sale_line_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="material_id"/>
                                <field name="kg"/>
                                <field name="price_unit"/>
                                <field name="subtotal" readonly="1"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirmar Venta" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_deliver" string="Marcar como Entregado" type="object" class="btn-primary" invisible="state != 'confirmed'"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_castu_material_sale" model="ir.actions.act_window">
        <field name="name">Ventas</field>
        <field name="res_model">castu.material.sale</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_castu_material_sale" name="Ventas" parent="menu_castu_materials_root" action="action_castu_material_sale" sequence="30"/>
</odoo>
