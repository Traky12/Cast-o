<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_castu_material_invoice_tree" model="ir.ui.view">
        <field name="name">castu.material.invoice.tree</field>
        <field name="model">castu.material.invoice</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="amount_total"/>
                <field name="state"/>
                <field name="sii_state"/>
            </tree>
        </field>
    </record>

    <record id="view_castu_material_invoice_form" model="ir.ui.view">
        <field name="name">castu.material.invoice.form</field>
        <field name="model">castu.material.invoice</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="date"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="partner_id"/>
                        <field name="sale_id"/>
                        <field name="state"/>
                        <field name="sii_state"/>
                        <field name="blockchain_tx" readonly="1"/>
                    </group>
                    <group>
                        <field name="invoice_line_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="material_id"/>
                                <field name="kg"/>
                                <field name="price_unit"/>
                                <field name="subtotal" readonly="1"/>
                            </tree>
                        </field>
                    </group>
                    <group string="Facturae / SII" invisible="state == 'draft'">
                        <field name="sii_response" readonly="1" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirmar Factura" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_send_sii" string="Enviar a SII" type="object" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_view_xml" string="Descargar XML Facturae" type="object" class="btn-secondary" invisible="state not in ('confirmed', 'sent', 'paid')"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_castu_material_invoice" model="ir.actions.act_window">
        <field name="name">Facturas de Materiales</field>
        <field name="res_model">castu.material.invoice</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_castu_material_invoice"
        name="Facturación"
        parent="castu_materials.menu_castu_materials_root"
        action="action_castu_material_invoice"
        sequence="35"/>
</odoo>
