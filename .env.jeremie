# CASTÚO JEREMIE/CTAEX — variables de entorno
# Uso: cp .env.jeremie .env && docker-compose -f docker-compose.jeremie.yml up -d

# PostgreSQL
POSTGRES_PASSWORD=ctaex17_ssl_2026_jeremie
POSTGRES_DB=castuo_jeremie
POSTGRES_USER=castuo_user
POSTGRES_SSL_MODE=disable
POSTGRES_SSL_ENFORCED=false

# API (token Bearer para /health y /events)
API_TOKEN=ctaex17_jeremie_token

# Backups OVH (opcional)
S3_BUCKET=castuo-backups-jeremie
S3_ENDPOINT=s3.gra.io.cloud.ovh.net
