# Copiar a .env.camera y ajustar. No subir .env.camera al VCS.
# Backend (misma máquina, puertos publicados):
#   CASTUO_MOTIONEYE_BASE=http://127.0.0.1:8765
# Backend dentro de Docker en la misma red:
#   CASTUO_MOTIONEYE_BASE=http://motioneye:8765

MOTIONEYE_PORT_DASH=8765
MOTIONEYE_PORT_RTSP=8081
MOTIONEYE_PORT_RTSP_MAIN=554
MOTIONEYE_DATA=./data/motioneye

# Usuario/clave del UI MotionEye (configurar en primer acceso o según imagen).
# El proxy CASTÚO usa estas vars para httpx Basic hacia MotionEye:
CASTUO_MOTIONEYE_USER=castuo_admin
CASTUO_MOTIONEYE_PASSWORD=cambiar_en_produccion_seguro
