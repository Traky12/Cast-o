# Copiar a .env.n8n-multi → docker compose -f docker-compose.multi-n8n.yml --env-file .env.n8n-multi up -d
# Comparte AGRI-BRAIN / CASTÚO con las cuatro instancias; cada contenedor recibe el mismo fichero vía env_file.

N8N_ENCRYPTION_KEY=CAMBIA_openssl_rand_hex_24
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_PASSWORD=CAMBIA_password_fuerte
GENERIC_TIMEZONE=Europe/Madrid

CASTUO_API_KEY=default_n8n_key_123
CASTUO_ZONE_ID=zone_cannabis_1
CASTUO_API_URL=http://host.docker.internal:8000
CASTUO_BASE_URL=http://host.docker.internal:8000
MISTRAL_API_KEY=

# Puertos en el host (contenedor interno siempre 5678)
N8N_SENSORES_PORT=5678
N8N_SATELITES_PORT=5679
N8N_SIMULACION_PORT=5680
N8N_DRONES_PORT=5681
N8N_TRILLIZO_PORT=5682

# WEBHOOK_URL por instancia (barra final como exige n8n). Desde el host:
N8N_SENSORES_WEBHOOK_URL=http://localhost:5678/
N8N_SATELITES_WEBHOOK_URL=http://localhost:5679/
N8N_SIMULACION_WEBHOOK_URL=http://localhost:5680/
N8N_DRONES_WEBHOOK_URL=http://localhost:5681/
N8N_TRILLIZO_WEBHOOK_URL=http://localhost:5682/

# Clave de cifrado n8n dedicada al Trillizo (volumen propio). Vacío = misma que N8N_ENCRYPTION_KEY.
N8N_TRILLIZO_ENCRYPTION_KEY=

# Gateway HTTP (workflow castuo_main_orchestrator_gateway) — si corre DENTRO de esta red Docker:
# usar nombres de servicio, sin barra final en estas cuatro:
N8N_WEBHOOK_BASE_SENSORES=http://n8n-sensores:5678
N8N_WEBHOOK_BASE_SATELITES=http://n8n-satelites:5678
N8N_WEBHOOK_BASE_SIMULACION=http://n8n-simulacion:5678
N8N_WEBHOOK_BASE_DRONES=http://n8n-drones:5678
N8N_WEBHOOK_BASE_TRILLIZO=http://n8n-trillizo:5678
# Fallback para rutas sin dominio dedicado (typeform-lead, api/query) y si falta un BASE_*:
N8N_WEBHOOK_BASE=http://n8n-sensores:5678

CASTUO_ORCHESTRATOR_API_KEY=
CASTUO_FORWARD_API_KEY=

# Diario Markdown → SilverBullet auditor: n8n-trillizo monta ./cerebros/auditoria en /data/cerebros-auditoria
# (levantar también docker-compose.cerebros.yml para la UI en :3003)
# Opcional: firma HMAC-SHA256 para POST /webhook/audit-trigger (01-trillizo-auditoria-basica.json)
# CASTUO_AUDIT_WEBHOOK_SECRET=

# Workflow 02-agente-diagnostico-ultra.json — enjambre: una identidad por núcleo / réplica
# Ejemplo núcleo 114 (ajusta por instancia u override compose):
# CORE_ID=NUCLEO-114
# SECTOR_ID=ZAFRA-SUR
SECTOR_ID=demo-sector-1
CORE_ID=alpha
# Misma red Docker que multi-n8n: nombre de servicio trillizo
CASTUO_TRILLIZO_AUDIT_URL=http://n8n-trillizo:5678/webhook/audit-trigger
# Referencia para credencial Postgres en n8n (host no resuelve postgres-cerebros desde multi-n8n)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5433

# --- Misma matriz AGRI-BRAIN que .env.n8n-castuo.example (copiar o incluir referencia) ---
DATA_TABLE_SENSORES=agri_brain.lecturas_sensores
DATA_TABLE_CULTIVOS=agri_brain.cultivos
DATA_TABLE_COSECHAS=agri_brain.cosechas
DATA_TABLE_ANALYSIS=agri_brain.analysis
SLACK_CHANNEL_ALERTS=#agri-brain-alerts
SLACK_CHANNEL_VENTAS=#agri-brain-sales
SLACK_CHANNEL_TECHNICAL=#agri-brain-tech
SLACK_CHANNEL_SATELITAL=#agri-brain-satellite
SLACK_CHANNEL_SIMULACIONES=#agri-brain-simulaciones
SLACK_CHANNEL_CARTOGRAFIA=#agri-brain-cartografia
ADMIN_EMAIL=admin@castuo.system
TEAM_EMAILS=team@castuo.system,engineering@castuo.system
CEO_EMAIL=ceo@castuo.system
CERTIFICACION_EMAIL=certificacion@castuo.system
CLIENT_EMAIL=clients@castuo.system
AGRONOMIA_EMAIL=agronomia@castuo.system
POWER_BI_STREAMING_ENDPOINT=
POWER_BI_CERTIFICADOS_ENDPOINT=
PDF_GENERATION_SERVICE_URL=
LATEX_COMPILATION_SERVICE=
LATEX_COMPILATION_SERVICE_URL=
BLENDER_SERVICE_URL=
GAIACHAIN_API_ENDPOINT=
GAIACHAIN_API_KEY=
GAIACHAIN_SIMULATION_ENDPOINT=
GAIACHAIN_SATELITAL_ENDPOINT=
GAIACHAIN_CARTOGRAFIA_ENDPOINT=
GAIACHAIN_GEMELO_DIGITAL_ENDPOINT=
PIX4D_API_KEY=
POLYGON_NFT_MINTING_SERVICE=
POLYGON_NFT_MINTING_SERVICE_URL=
POLYGON_API_KEY=
PDF_GENERATION_SERVICE=
BACKUP_SPREADSHEET=castuo_backup
BACKUP_SHEET=sensores
BACKUP_SPREADSHEET_CULTIVOS=castuo_backup
BACKUP_SHEET_CULTIVOS=cultivos
BACKUP_SPREADSHEET_ANALYSIS=castuo_backup
BACKUP_SHEET_ANALYSIS=analysis
LOG_AUDITORIA_TRAZABILIDAD=agri_brain.log_auditoria
LOG_INCIDENCIAS=agri_brain.log_incidencias
GATEWAY_REQUESTS=agri_brain.gateway_requests
GATEWAY_ERRORS=agri_brain.gateway_errors

