{
  "name": "Autonomous Improvement (CodeAgent-X)",
  "nodes": [
    {
      "parameters": {
        "path": "autonomous-improvement",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "name": "Webhook: Mejora Autónoma",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "webhookId": "autonomous-improvement",
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "=http://localhost:8000/agents/autonomous-improvement",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ metric: $json.body?.metric || 'yield', current_value: $json.body?.current_value ?? 98.5, target_value: $json.body?.target_value ?? 99.0 }) }}",
        "options": {}
      },
      "name": "Llamar a CodeAgent-X",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "success",
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "name": "¿Éxito?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "content": "=✅ Mejora autónoma implementada:\n- **Métrica**: {{ $('Webhook: Mejora Autónoma').item.json.body?.metric || 'yield' }}\n- **Antes**: {{ $('Webhook: Mejora Autónoma').item.json.body?.current_value }}\n- **Después**: {{ $('Webhook: Mejora Autónoma').item.json.body?.target_value }}\n- **MR**: {{ $json.gitlab_mr?.iid }}\n- **GaiaChain TX**: {{ $json.gaiachain_tx }}",
        "options": {}
      },
      "name": "Notificar Éxito",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [660, -100],
      "notes": "Conectar a Slack/Email: canal C0123ABCDE o tu canal"
    },
    {
      "parameters": {
        "content": "=⚠️ Fallo en mejora autónoma:\n- **Razón**: {{ $json.reason }}\n- **Detalles**: {{ JSON.stringify($json.details) }}",
        "options": {}
      },
      "name": "Notificar Fallo",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [660, 100],
      "notes": "Conectar a Slack/Email para alertas"
    }
  ],
  "connections": {
    "Webhook: Mejora Autónoma": {
      "main": [[{ "node": "Llamar a CodeAgent-X", "type": "main", "index": 0 }]]
    },
    "Llamar a CodeAgent-X": {
      "main": [[{ "node": "¿Éxito?", "type": "main", "index": 0 }]]
    },
    "¿Éxito?": {
      "main": [
        [{ "node": "Notificar Éxito", "type": "main", "index": 0 }],
        [{ "node": "Notificar Fallo", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
