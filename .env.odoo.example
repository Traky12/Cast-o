# CASTUO-SYSTEM™ — CRM/ERP/LEGAL (Odoo + Nextcloud + EPCIS)
# Uso: cp .env.odoo.example .env.odoo

# --- Odoo ---
ODOO_DB_NAME=odoo
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo

# --- Nextcloud ---
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=nextcloud
NEXTCLOUD_DB_ROOT_PASSWORD=nextcloud_root

# --- EPCIS / OpenEPCIS ---
EPCIS_DB_NAME=castuo_epcis
EPCIS_DB_USER=castuo_user
EPCIS_DB_PASSWORD=castuo_password

