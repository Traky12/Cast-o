# =============================================================
# CASTÚO-SYSTEM™ v3.0 — Variables de Entorno
# Arquitectura Soberana Europea
# RGPD | AI Act UE | eIDAS | Hetzner | Arsys
#
# INSTRUCCIONES:
# 1. Copiar este fichero: cp .env.example .env
# 2. Rellenar TODOS los valores marcados con <CHANGE_ME>
# 3. NUNCA commitear el fichero .env al repositorio
# =============================================================

# ─────────────────────────────────────────────────────────────
# ENTORNO
# ─────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ─────────────────────────────────────────────────────────────
# SEGURIDAD — JWT (eIDAS ES256)
# Generar con: openssl rand -hex 64
# ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# AI — CLAUDE CODE (Anthropic)
# ─────────────────────────────────────────────────────────────
CLAUDE_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# AI — MISTRAL AI (Soberanía UE)
# https://console.mistral.ai/api-keys
# ─────────────────────────────────────────────────────────────
MISTRAL_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# AI — CURSOR AI
# ─────────────────────────────────────────────────────────────
CURSOR_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# SABIONDA IA
# ─────────────────────────────────────────────────────────────
SABIONDA_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# BASE DE DATOS — Arsys PostgreSQL 16 (Soberanía UE)
# ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=<CHANGE_ME>
ARSYS_DB_HOST=arsys-db
ARSYS_DB_NAME=castuo_db
ARSYS_DB_USER=castuo
ARSYS_DB_PASSWORD=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# N8N — Orquestación de Workflows
# ─────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=<CHANGE_ME>
N8N_API_KEY=<CHANGE_ME>
# Generar con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=<CHANGE_ME>
WEBHOOK_URL=https://n8n.castuo-system.eu

# ─────────────────────────────────────────────────────────────
# HETZNER CLOUD — Infraestructura EU
# https://console.hetzner.cloud → API Tokens
# ─────────────────────────────────────────────────────────────
HETZNER_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# BLOCKCHAIN — GaiaChain 3.0 (Soberanía UE, PoA)
# ─────────────────────────────────────────────────────────────
GAIACHAIN_API_KEY=<CHANGE_ME>
GAIACHAIN_CONTRACT_TRAZABILIDAD=0x7aCeE349bD40ED460d8575A3F245790E81Ce3AdB
GAIACHAIN_CONTRACT_GEOTRACE=0xAcF357a9a8e8578b5AcC959D3c56c62F9639b09A
GAIACHAIN_CONTRACT_CERTIFICADOS=0x5f8a58f6E3e9C965C53681e15922E69E20583491

# ─────────────────────────────────────────────────────────────
# IPFS CLUSTER — Almacenamiento Distribuido UE
# ─────────────────────────────────────────────────────────────
IPFS_API_KEY=<CHANGE_ME>
# Generar con: openssl rand -hex 32
IPFS_CLUSTER_SECRET=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# QR GENERATOR — Trazabilidad ECC-256
# ─────────────────────────────────────────────────────────────
QR_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# LORAWAN — Sensores IoT de Campo
# ─────────────────────────────────────────────────────────────
LORAWAN_API_KEY=<CHANGE_ME>
LORAWAN_DEVICE_001=0xABCD1234
LORAWAN_DEVICE_002=0xEFGH5678
LORAWAN_DEVICE_003=0xIJKL9012

# ─────────────────────────────────────────────────────────────
# APIS GUBERNAMENTALES (España)
# ─────────────────────────────────────────────────────────────
SIEX_API_URL=https://siex.mapa.gob.es/api
TRACES_API_URL=https://webgate.ec.europa.eu/tracesnt/api
SIGPAC_API_URL=https://sigpac.mapa.gob.es/api
REGEPA_API_URL=https://regepa.mapa.gob.es/api

# --- CORS ---
ALLOWED_ORIGINS=https://castuo-system.es,https://n8n.castuo-system.es

# --- Cloud / Secrets (recommended for production) ---
VAULT_ADDR=https://vault.castuo-system.cloud:8200
VAULT_TOKEN_FILE=/run/secrets/vault_token
CASTUO_SABIONDA_API_KEY_FILE=/run/secrets/sabionda_api_key

# --- IoT ---
CASTUO_IOT_TELEMETRY_URL=http://mosquitto:1883
CASTUO_IOT_DEVICE_CMD_URL=http://openclaw-agente:8080
CASTUO_IOT_TIMEOUT_S=30
CASTUO_IOT_BEARER_FILE=/run/secrets/iot_bearer

# --- Robotics Chain / Gaia ---
CASTUO_ROBOTICS_LAB_CHAIN_REGISTER=0

# ─────────────────────────────────────────────────────────────
# TIMESCALEDB — Persistencia IoT duradera
# ─────────────────────────────────────────────────────────────
TIMESCALE_DB_HOST=timescale.castuo-system.cloud
TIMESCALE_DB_PORT=5432
TIMESCALE_DB_NAME=castuo_telemetry
TIMESCALE_DB_USER=castuo_iot
TIMESCALE_DB_PASSWORD=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# SEGURIDAD IoT — JWT por dispositivo + rate limiting
# Generar con: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
DEVICE_JWT_SECRET=<CHANGE_ME>
IOT_RATE_LIMIT=100
MFA_SECRET=<CHANGE_ME>
MFA_ENABLED=false
REDIS_URL=redis://redis.castuo-system.cloud:6379/0
API_RATE_LIMIT=100

# ─────────────────────────────────────────────────────────────
# eIDAS — Firma electrónica cualificada (Nivel Alto)
# ─────────────────────────────────────────────────────────────
EIDAS_PRIVATE_KEY_PATH=/secrets/eidas_private_key.pem
EIDAS_CERT_URL=https://trusted-service.castuo-system.cloud/cert
EIDAS_TSA_URL=https://tsa.castuo-system.cloud/tsa

# ─────────────────────────────────────────────────────────────
# TRACES UE — Trazabilidad oficial
# ─────────────────────────────────────────────────────────────
TRACES_API_KEY=<CHANGE_ME>
TRACES_OPERATOR_ID=ES-CASTUO-001

# ─────────────────────────────────────────────────────────────
# HYPERLEDGER FABRIC — Trazabilidad distribuida
# ─────────────────────────────────────────────────────────────
HYPERLEDGER_URL=http://hyperledger.castuo-system.cloud:7050
HYPERLEDGER_CHANNEL=castuo-channel
HYPERLEDGER_CHAINCODE=traces-cc

# ─────────────────────────────────────────────────────────────
# MULTI-TENANCY
# ─────────────────────────────────────────────────────────────
TENANT_ID=default
TENANT_NAME=CASTUO-SYSTEM-Default

# ─────────────────────────────────────────────────────────────
# GDPR Backups
# ─────────────────────────────────────────────────────────────
GDPR_BACKUP_BUCKET=castuo-gdpr-backups
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=<CHANGE_ME>
AWS_SECRET_ACCESS_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# TimescaleDB HA
# ─────────────────────────────────────────────────────────────
TIMESCALE_DB_REPLICAS=3
CASTUO_ROBOTICS_LAB_CHAIN_INCLUDE_PARCEL_ID=0
GAIA_CHAIN_RPC=
GAIA_CHAIN_AUDIT_CONTRACT=
GAIA_CHAIN_AUDIT_ABI=
GAIA_CHAIN_PRIVATE_KEY_FILE=/run/secrets/gaia_chain_private_key
CASTUO_NEUROMORPHIC_LAB=0

# --- Object Storage ---
AWS_DEFAULT_REGION=eu-central-1
AWS_S3_BUCKET=castuo-system-logs

# --- Option C (local dev only, never in production) ---
# CASTUO_SABIONDA_API_KEY=plain_text_token

# ─────────────────────────────────────────────────────────────
# MONITORIZACIÓN — Prometheus + Grafana + ELK
# ─────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=<CHANGE_ME>
GRAFANA_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# TWILIO — Alertas WhatsApp por IoT
# Obtener en: https://console.twilio.com
# ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=<CHANGE_ME>
TWILIO_AUTH_TOKEN=<CHANGE_ME>
TWILIO_WHATSAPP_FROM=<CHANGE_ME>
TWILIO_API_TOKEN=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# SYSTEM EMERGENCY CONTACTS — Contactos de emergencia
# ─────────────────────────────────────────────────────────────
SYSTEM_ADMIN_PHONE=+34693443825
SYSTEM_ADMIN_EMAIL=admin@castuo.es

# ─────────────────────────────────────────────────────────────
# ALERT CONFIGURATION — Alertas IoT
# ─────────────────────────────────────────────────────────────
ENABLE_WHATSAPP_ALERTS=true
DEFAULT_ALERT_CHANNELS=whatsapp,email,slack
WHATSAPP_MIN_SEVERITY=HIGH

# ─────────────────────────────────────────────────────────────
# N8N WEBHOOKS — Endpoints para workflows
# ─────────────────────────────────────────────────────────────
N8N_WEBHOOK_ALERT_URL=http://n8n:5678/webhook/thingsdata-alerts
N8N_WEBHOOK_WHATSAPP_URL=http://n8n:5678/webhook/thingsdata-alerts-whatsapp
N8N_TWILIO_CREDENTIAL_ID=<CHANGE_ME>

# ELK Stack
ELASTIC_PASSWORD=<CHANGE_ME>

# Alertmanager webhook (Slack, Teams, PagerDuty, etc.)
ALERT_WEBHOOK_URL=<CHANGE_ME>

# Chaos Engineering (desactivado por defecto en producción)
CHAOS_ENGINEERING_ENABLED=false
