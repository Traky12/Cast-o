# Copia a .env y rellena con tus valores reales.
# cp .env.example .env

# Base de datos (genérico)
DB_USER=postgres
DB_PASSWORD=

# --- SABIONDA Pro / CTAEX (PostgreSQL para cannabis y microgreens) ---
# Descomentar y rellenar cuando se use migración a PostgreSQL (ver docs/POSTGRESQL-MIGRATION-PLAN.md)
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=castuo_ctaex
# DB_USER=castuo_admin
# DB_PASSWORD=                    # Cambiar en producción

# GaiaChain (trazabilidad blockchain)
# GAIA_CHAIN_RPC_URL=https://rpc.gaia-chain.com
# GAIA_CHAIN_API_KEY=             # o GAIA_API_KEY en docker-compose.ctaex.yml

# AEMPS (validación de licencias cannabis; sandbox en desarrollo)
# AEMPS_API_URL=https://api.aemps.gob.es/sandbox
# AEMPS_API_KEY=sandbox_key

# Stripe (pagos; CTAEX usa STRIPE_SECRET o STRIPE_SECRET_KEY — ver backend/routers/ctaex.py)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# FRONTEND_URL=http://localhost:8080

# Redis (caché, opcional)
# REDIS_HOST=redis
# REDIS_PORT=6379

# --- Agentes federados v2.0 (producción) ---
# Vault (gestión de claves post-cuánticas)
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=                    # Root token o token con política castuo-admin
# Claves PQC: directorio local si no se usa Vault (por defecto backend/security/keys)
# CASTUO_KEY_DIR=                 # ej. /etc/castuo/keys en producción
# RabbitMQ (mensajería entre agentes)
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_PORT=5672
# RABBITMQ_USER=castuo
# RABBITMQ_PASSWORD=              # Cambiar en producción
# Prometheus (métricas para Agente Maestro)
# PROMETHEUS_URL=http://prometheus:9090
# Grafana (dashboards)
# GRAFANA_URL=http://grafana:3000
# Mistral (obligatorio para agentes de IA)
# MISTRAL_API_KEY_EU=            # Clave EU recomendada para cumplimiento

# MQTT (IoT)
# MQTT_BROKER=mqtt
# MQTT_PORT=1883
# MQTT_USER=iot_user
# MQTT_PASSWORD=                  # Opcional

# N8N
N8N_USER=admin
N8N_PASSWORD=

# Gmail
GMAIL_USER=
GMAIL_PASSWORD=

# WhatsApp Business
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_BUSINESS_PHONE_ID=

# Notion
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Ollama Cloud (opcional; análisis agua /water/ctaex/analyze — API OpenAI-compatible)
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://api.ollama.com/v1
# OLLAMA_MODEL=llama3.2:3b
# LANGSMITH_API_KEY=

# Monetización opcional /water/ctaex (cuotas por clave; por defecto desactivado — n8n sin cambios)
# WATER_CTAEX_ENFORCE_QUOTA=0
# Mapa JSON: clave API → plan (free|basic|pro|enterprise). Ej. {"mi-clave-n8n":"basic"}
# WATER_API_KEY_TO_PLAN={}
# CASTUO_SALES_EMAIL=sales@ejemplo.es
# Informe de trazas: GET /water/ctaex/subscription/usage-report + cabecera X-USAGE-REPORT-KEY
# WATER_USAGE_REPORT_KEY=
# Registro de clientes (facturación): POST /water/ctaex/subscription/register + X-BILLING-REGISTER-KEY
# WATER_BILLING_REGISTER_KEY=
# SMTP (recordatorios / envío de facturas)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=billing@ejemplo.es
# Recordatorios: solo facturas ≥ N días vencidas (0 = todas las vencidas)
# WATER_OVERDUE_MIN_DAYS=0
# Alertas scripts/notifications.py: fracción de cuota (0.8 = 80 %)
# WATER_QUOTA_ALERT_THRESHOLD=0.8

# Agentes / Claude Code EU (rutas /water/ctaex/subscription/ai/* — cabecera X-AI-KEY)
# AI_ACCOUNT_MANAGER_ENABLED=0
# AI_FINANCIAL_ANALYST_ENABLED=0
# AI_TECHNICAL_SUPPORT_ENABLED=0
# AI_INTEGRATION_KEY=
# API_BASE_URL=http://127.0.0.1:8000

# Mistral AI
MISTRAL_API_URL=https://api.mistral.ai
MISTRAL_API_KEY=
# Agentes v2.0 (clave EU recomendada para cumplimiento)
MISTRAL_API_KEY_EU=

# LondBot
LONDBOT_API_URL=https://api.londbot.com
LONDBOT_API_KEY=

# Arsys
ARSYS_API_URL=https://api.arsys.es
ARSYS_API_KEY=

# Money
MONEY_API_URL=https://api.money.com
MONEY_API_KEY=

# Dronica / LoRaWAN
DRONICA_MQTT_BROKER=mqtt://mqtt:1883
DRONICA_MQTT_TOPIC=dronica/missions

# Grafana (docker-compose.monitor.yml)
GRAFANA_ADMIN_PASSWORD=

# Certbot (Hetzner)
CERTBOT_EMAIL=
DOMAIN=

# --- Soberanía datos UE / Copernicus (energy_audit/satellite_preprocess) ---
# CASTUO_EU_DATA_SOVEREIGNTY=1   # Por defecto en código: excluye Landsat del catálogo; use 0 solo con DPIA
# COPERNICUS_USER=
# COPERNICUS_PASSWORD=
# COPERNICUS_DHUS_BASE=https://scihub.copernicus.eu/dhus   # Solo hosts *.copernicus.eu
# Stack compose PostgreSQL + guía FOSS UE: ver .env.eu-sovereignty.example y docs/deploy/EU-FOSS-SOVEREIGNTY-STACK.md
# n8n CASTÚO: .env.n8n-castuo.example + docker-compose.n8n-castuo.yml + docs/deploy/PRONTUARIO-CONEXIONES-COMPLETAS-AUTOMATIZACION-2026.md

# Otros
VECHAIN_GATEWAY_URL=
VECHAIN_API_KEY=
CASTUO_TOKEN_GATEWAY_URL=
CASTUO_TOKEN_API_KEY=

# --- Fachada Sabionda (scripts/sabionda/facade.py): métricas solo si están medidas ---
# CASTUO_REGION=Extremadura
# CASTUO_MEASURED_YIELD_PCT=
# CASTUO_MEASURED_VS_UE_DELTA_PCT=
# CASTUO_MEASURED_CARBON_KG=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_B001=
