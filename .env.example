# Environment Configuration for SABIONDA - Castúo-System v2.0
# Copy this file to .env and fill in the required values

# --- PostgreSQL ---
POSTGRES_PASSWORD=changeme_use_strong_password

# --- N8n ---
N8N_USER=admin
N8N_PASSWORD=changeme_use_strong_password
WEBHOOK_URL=http://localhost:5678

# --- External API URLs (official government APIs) ---
SIEX_API_URL=https://siex.mapa.gob.es/api
TRACES_API_URL=https://webgate.ec.europa.eu/tracesnt/api
SIGPAC_API_URL=https://sigpac.mapa.gob.es/api
