# =============================================================
# CASTÚO-SYSTEM™ v3.0 — Variables de Entorno
# Arquitectura Soberana Europea
# RGPD | AI Act UE | eIDAS | Hetzner | Arsys
#
# INSTRUCCIONES:
# 1. Copiar este fichero: cp .env.example .env
# 2. Rellenar TODOS los valores marcados con <CHANGE_ME>
# 3. NUNCA commitear el fichero .env al repositorio
# =============================================================

# ─────────────────────────────────────────────────────────────
# ENTORNO
# ─────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ─────────────────────────────────────────────────────────────
# SEGURIDAD — JWT (eIDAS ES256)
# Generar con: openssl rand -hex 64
# ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# AI — CLAUDE CODE (Anthropic)
# ─────────────────────────────────────────────────────────────
CLAUDE_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# AI — MISTRAL AI (Soberanía UE)
# https://console.mistral.ai/api-keys
# ─────────────────────────────────────────────────────────────
MISTRAL_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# AI — CURSOR AI
# ─────────────────────────────────────────────────────────────
CURSOR_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# SABIONDA IA
# ─────────────────────────────────────────────────────────────
SABIONDA_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# BASE DE DATOS — Arsys PostgreSQL 16 (Soberanía UE)
# ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=<CHANGE_ME>
ARSYS_DB_HOST=arsys-db
ARSYS_DB_NAME=castuo_db
ARSYS_DB_USER=castuo
ARSYS_DB_PASSWORD=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# N8N — Orquestación de Workflows
# ─────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=<CHANGE_ME>
N8N_API_KEY=<CHANGE_ME>
# Generar con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=<CHANGE_ME>
WEBHOOK_URL=https://n8n.castuo-system.eu

# ─────────────────────────────────────────────────────────────
# HETZNER CLOUD — Infraestructura EU
# https://console.hetzner.cloud → API Tokens
# ─────────────────────────────────────────────────────────────
HETZNER_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# BLOCKCHAIN — GaiaChain 3.0 (Soberanía UE, PoA)
# ─────────────────────────────────────────────────────────────
GAIACHAIN_API_KEY=<CHANGE_ME>
GAIACHAIN_CONTRACT_TRAZABILIDAD=0x7aCeE349bD40ED460d8575A3F245790E81Ce3AdB
GAIACHAIN_CONTRACT_GEOTRACE=0xAcF357a9a8e8578b5AcC959D3c56c62F9639b09A
GAIACHAIN_CONTRACT_CERTIFICADOS=0x5f8a58f6E3e9C965C53681e15922E69E20583491

# ─────────────────────────────────────────────────────────────
# IPFS CLUSTER — Almacenamiento Distribuido UE
# ─────────────────────────────────────────────────────────────
IPFS_API_KEY=<CHANGE_ME>
# Generar con: openssl rand -hex 32
IPFS_CLUSTER_SECRET=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# QR GENERATOR — Trazabilidad ECC-256
# ─────────────────────────────────────────────────────────────
QR_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# LORAWAN — Sensores IoT de Campo
# ─────────────────────────────────────────────────────────────
LORAWAN_API_KEY=<CHANGE_ME>
LORAWAN_DEVICE_001=0xABCD1234
LORAWAN_DEVICE_002=0xEFGH5678
LORAWAN_DEVICE_003=0xIJKL9012

# ─────────────────────────────────────────────────────────────
# APIS GUBERNAMENTALES (España)
# ─────────────────────────────────────────────────────────────
SIEX_API_URL=https://siex.mapa.gob.es/api
TRACES_API_URL=https://webgate.ec.europa.eu/tracesnt/api
SIGPAC_API_URL=https://sigpac.mapa.gob.es/api
REGEPA_API_URL=https://regepa.mapa.gob.es/api

# ─────────────────────────────────────────────────────────────
# MONITORIZACIÓN — Prometheus + Grafana + ELK
# ─────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=<CHANGE_ME>
GRAFANA_API_KEY=<CHANGE_ME>

# ELK Stack
ELASTIC_PASSWORD=<CHANGE_ME>

# Alertmanager webhook (Slack, Teams, PagerDuty, etc.)
ALERT_WEBHOOK_URL=<CHANGE_ME>

# Chaos Engineering (desactivado por defecto en producción)
CHAOS_ENGINEERING_ENABLED=false

# ─────────────────────────────────────────────────────────────
# SECRETS — Opción A (recomendado prod): rutas a ficheros montados
# Ref: PRONTUARIO-LEGAL-MAESTRO-ROBOTICS-2026.md §1 (Matriz A/B/C)
#
# En Docker Swarm / Compose con secrets:
#   CASTUO_ADMIN_GENERAL_BEARER_FILE=/run/secrets/castuo_admin_general_bearer
#   CASTUO_ROBOTICS_LAB_BEARER_TOKEN_FILE=/run/secrets/robotics_lab_bearer
#   GAIACHAIN_API_KEY_FILE=/run/secrets/gaiachain_api_key
#   IPFS_API_KEY_FILE=/run/secrets/ipfs_api_key
#
# NUNCA poner valores reales en este fichero (.env.example se versiona).
# Crear ./secrets/ y añadirla a .gitignore — no subir contenido al git.
# ─────────────────────────────────────────────────────────────

# Bearer tokens (Opción A — rutas a ficheros)
CASTUO_ADMIN_GENERAL_BEARER_FILE=
CASTUO_ADMIN_CTAEX_BEARER_FILE=
CASTUO_TECHNICIAN_BEARER_FILE=
CASTUO_AUDITOR_BEARER_FILE=
CASTUO_ROBOTICS_LAB_BEARER_TOKEN_FILE=

# Bearer tokens (Opción C — solo dev local; NUNCA en prod ni en git versionado)
# CASTUO_ADMIN_GENERAL_BEARER=<CHANGE_ME>
# CASTUO_ROBOTICS_LAB_BEARER_TOKEN=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# VAULT — Opción B (alternativo prod): HashiCorp Vault KV v2
# Ref: §2 Prontuario Secrets — vault_token_for_client()
# ─────────────────────────────────────────────────────────────
VAULT_ADDR=
# VAULT_TOKEN=<CHANGE_ME>        # Opción B.1 — token en env (solo dev)
VAULT_TOKEN_FILE=                 # Opción B.2 — ruta al fichero con el token

# ─────────────────────────────────────────────────────────────
# RGPD art. 25 — Privacy by design: parcel_ref on-chain opt-in
# Ref: PRONTUARIO-LEGAL-MAESTRO-ROBOTICS-2026.md §2.1
# Por defecto: sigpac_ref NO se incluye en el flujo on-chain.
# Activar SOLO tras aprobación explícita del DPO (DPIA §6).
# ─────────────────────────────────────────────────────────────
CASTUO_ROBOTICS_LAB_CHAIN_INCLUDE_PARCEL_ID=0

# ─────────────────────────────────────────────────────────────
# BLOCKCHAIN ON-CHAIN REGISTER — DPIA-Robotics-2026 §6
# Habilita registro en GaiaChain; expone chain_status en /health.
# 0 → disabled (por defecto, seguro)
# 1 → activo; requiere todas las vars GAIA_CHAIN_* configuradas
# ─────────────────────────────────────────────────────────────
CASTUO_ROBOTICS_LAB_CHAIN_REGISTER=0
GAIA_CHAIN_RPC=
GAIA_CHAIN_AUDIT_CONTRACT=
GAIA_CHAIN_AUDIT_ABI=
# Opción A (recomendado prod): ruta al fichero con la clave privada
GAIA_CHAIN_PRIVATE_KEY_FILE=
# Opción C (solo dev local; NUNCA en prod ni en git versionado):
# GAIA_CHAIN_PRIVATE_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# LAB NEUROMÓRFICO — DPIA-Robotics-2026 §6
# ─────────────────────────────────────────────────────────────
CASTUO_NEUROMORPHIC_LAB=0

# ─────────────────────────────────────────────────────────────
# AEMET OpenData — Datos meteorológicos
# Registro gratuito: https://opendata.aemet.es/centrodedescargas/altaUsuario
# ─────────────────────────────────────────────────────────────
AEMET_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# IoT — Controladores de campo (bombas, electroválvulas, sensores)
# Ref: PRONTUARIO-LEGAL-MAESTRO-ROBOTICS-2026.md §1
#      DPIA-Robotics-2026 §4 (cifrado en tránsito)
#
# CASTUO_IOT_TELEMETRY_URL : endpoint que recibe telemetría de sensores
# CASTUO_IOT_DEVICE_CMD_URL: endpoint del MQTT gateway para actuadores
#   Sin estas URLs los controladores loguean warning y no fallan (fail-safe).
#   Con ellas activas se requiere CASTUO_IOT_BEARER (Opción A recomendado).
# ─────────────────────────────────────────────────────────────
CASTUO_IOT_TELEMETRY_URL=
CASTUO_IOT_DEVICE_CMD_URL=
CASTUO_IOT_TIMEOUT_S=10
# Opción A (recomendado prod): ruta al fichero con el bearer token IoT
CASTUO_IOT_BEARER_FILE=
# Opción C (solo dev local; NUNCA en prod):
# CASTUO_IOT_BEARER=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# API CORS — dominios permitidos (separados por coma)
# ─────────────────────────────────────────────────────────────
CASTUO_CORS_ORIGINS=https://castuo360.eu,https://www.castuo360.eu,http://wordpress:80,http://langgraph:8200

# ─────────────────────────────────────────────────────────────
# SATÉLITE EU — Copernicus Data Space Ecosystem (CDSE)
# Registro gratuito: https://dataspace.copernicus.eu/
# Acceso a Sentinel-1/2/3 con soberanía de datos UE
# ─────────────────────────────────────────────────────────────
COPERNICUS_CLIENT_ID=<CHANGE_ME>
COPERNICUS_CLIENT_SECRET=<CHANGE_ME>
COPERNICUS_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac
COPERNICUS_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_TIMEOUT_S=30

# ─────────────────────────────────────────────────────────────
# SATÉLITE EU — Almacenamiento de Objetos (Hetzner / S3-compatible)
# Hetzner Object Storage: https://www.hetzner.com/storage/object-storage
# ─────────────────────────────────────────────────────────────
OBJECT_STORAGE_ENDPOINT=https://fsn1.your-objectstorage.com
OBJECT_STORAGE_KEY=<CHANGE_ME>
OBJECT_STORAGE_SECRET=<CHANGE_ME>
OBJECT_STORAGE_BUCKET=castuo-satellite

# ─────────────────────────────────────────────────────────────
# SATÉLITE EU — Configuración del worker STAC
# ─────────────────────────────────────────────────────────────
STAC_POLL_INTERVAL_S=3600
STAC_MAX_CLOUD_COVER=20.0
STAC_LOOKBACK_DAYS=30
STAC_BBOX_PADDING_DEG=0.01
STAC_PARCELAS_FILE=/data/satellite/parcelas.json
NDVI_DATA_PATH=/data/satellite/ndvi
SATELLITE_RESULTS_PATH=/data/satellite/results

# ─────────────────────────────────────────────────────────────
# SABIONDA — Clave API del agente de IA
# ─────────────────────────────────────────────────────────────
SABIONDA_API_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# KUBERNETES — Acceso al cluster Hetzner
# Para CI/CD — NO commitear el fichero kubeconfig real
# ─────────────────────────────────────────────────────────────
# HETZNER_KUBECONFIG_B64=$(cat ~/.kube/hetzner.yaml | base64 | tr -d '\n')
HETZNER_KUBECONFIG_B64=<CHANGE_ME>

# ─────────────────────────────────────────────────────────────
# INFLUXDB — Series temporales de sensores e histórico
# ─────────────────────────────────────────────────────────────
INFLUXDB_URL=http://influxdb.castuo-system.svc.cluster.local:8086
INFLUXDB_TOKEN=<CHANGE_ME>
# INFLUXDB_TOKEN_FILE=/run/secrets/influxdb_token
INFLUXDB_ORG=castuo
INFLUXDB_BUCKET_SENSORS=invernadero_sensores
INFLUXDB_BUCKET_ENERGY=invernadero_energia
INFLUXDB_BUCKET_ACTUATORS=invernadero_actuadores

# ─────────────────────────────────────────────────────────────
# MODBUS — Inversor solar / medidor de energía
# ─────────────────────────────────────────────────────────────
MODBUS_INVERTER_HOST=192.168.1.100
MODBUS_INVERTER_PORT=502
MODBUS_UNIT_ID=1
MODBUS_TIMEOUT=5
SOLAR_PEAK_KW=10.0

# ─────────────────────────────────────────────────────────────
# MQTT ACTUADORES — Prefijo de topics de control
# ─────────────────────────────────────────────────────────────
MQTT_ACTUATOR_PREFIX=castuo/invernadero/actuadores

# ─────────────────────────────────────────────────────────────
# GITHUB — Integración webhook y API
# ─────────────────────────────────────────────────────────────
# Secreto del webhook configurado en GitHub → Settings → Webhooks
GITHUB_WEBHOOK_SECRET=<CHANGE_ME>
# GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret
# Token de API GitHub (para leer PRs, comentar, etc.)
GITHUB_TOKEN=<CHANGE_ME>
# GITHUB_TOKEN_FILE=/run/secrets/github_token
GITHUB_REPO=traky12/castuo-system

# ─────────────────────────────────────────────────────────────
# KAFKA — Mensajería asíncrona
# ─────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka.castuo-system.svc.cluster.local:9092
# Protocolo: PLAINTEXT | SSL | SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CLIENT_ID=castuo-system
KAFKA_GROUP_ID=castuo-workers
KAFKA_ACKS=all
KAFKA_RETRIES=3
# Para autenticación SASL (SASL_SSL):
KAFKA_SASL_USERNAME=<CHANGE_ME>
KAFKA_SASL_PASSWORD=<CHANGE_ME>
# KAFKA_SASL_PASSWORD_FILE=/run/secrets/kafka_sasl_password

# ─────────────────────────────────────────────────────────────
# CLAUDE (Anthropic) — Proxy con circuit breaker
# ─────────────────────────────────────────────────────────────
# (CLAUDE_API_KEY ya definido arriba)
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048
CLAUDE_TIMEOUT_S=30
CLAUDE_CIRCUIT_THRESHOLD=5

# ─────────────────────────────────────────────────────────────
# SEGURIDAD — MFA TOTP + Rate Limiting + Multi-tenancy
# ─────────────────────────────────────────────────────────────
# Habilitar verificación TOTP en endpoints protegidos
MFA_ENABLED=false
MFA_ISSUER=CASTUO-SYSTEM
# Rate limiting por IP+tenant
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_S=60
# Multi-tenancy
ALLOWED_TENANTS=castuo,demo,staging
DEFAULT_TENANT=castuo

# ─────────────────────────────────────────────────────────────
# REDIS HA — Cache distribuida (rate limiting, sessions)
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis.castuo-system.svc.cluster.local:6379
REDIS_PASSWORD=<CHANGE_ME>
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_SENTINEL_HOSTS=redis-sentinel.castuo-system.svc.cluster.local:26379
REDIS_SENTINEL_MASTER=castuo-redis

# ─────────────────────────────────────────────────────────────
# TIMESCALEDB HA — Series temporales (Patroni)
# ─────────────────────────────────────────────────────────────
TIMESCALE_DB_HOST=timescaledb.castuo-system.svc.cluster.local
TIMESCALE_DB_PORT=5432
TIMESCALE_DB_NAME=castuo_ts
TIMESCALE_DB_USER=castuo
TIMESCALE_DB_PASSWORD=<CHANGE_ME>
# TIMESCALE_DB_PASSWORD_FILE=/run/secrets/timescaledb_password
# Réplica de solo lectura
TIMESCALE_DB_REPLICA_HOST=timescaledb-replica.castuo-system.svc.cluster.local

# ─────────────────────────────────────────────────────────────
# CASTÚO API — URL para GitHub Actions
# ─────────────────────────────────────────────────────────────
# Configurar como GitHub Secret en el repositorio
CASTUO_API_URL=https://api.castuo-system.cloud
