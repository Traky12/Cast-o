# Bloquear escaneo de puertos
alert tcp any any -> any any (msg:"Port Scan Detected"; flow:stateless; flags:S; threshold:type threshold, track by_src, count 5, seconds 60; sid:1000001; rev:1;)

# Bloquear fuerza bruta en SSH
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"SSH Brute Force"; flow:to_server,established; content:"Failed password"; nocase; threshold:type threshold, track by_src, count 5, seconds 60; sid:1000002; rev:1;)
