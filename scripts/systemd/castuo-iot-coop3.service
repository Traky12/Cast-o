[Unit]
Description=IoT Monitor Cooperativa #3 (Tomate)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/castuo-system/backend
ExecStart=/usr/bin/python3 scripts/iot_monitor_3_coops.py --coop 3
Restart=always
RestartSec=10
Environment=BACKEND_URL=http://localhost:8001
Environment=IOT_MONITOR_LOG=/root/castuo-system/backend/logs/iot-monitor.log

[Install]
WantedBy=multi-user.target
