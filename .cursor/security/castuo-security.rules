rules:
  - name: "Bloquear APIs no soberanas"
    description: "Evita AWS/GCP/Google en el código; usar proveedores UE (Hetzner, OVH, etc.)."
    pattern: "(aws|googleapis|azure|amazonaws)"
    severity: "error"
    fix: "Usa endpoints de Hetzner (DE), OVH (FR) u otros proveedores europeos soberanos."

  - name: "Validar rangos básicos IoT"
    description: "Detecta hardcodes de temperatura/humedad fuera de rango típico."
    pattern: "temp\\s*[:=]\\s*[-]?[0-9]{2,}|hum\\s*[:=]\\s*[0-9]{3,}"
    severity: "warning"
    fix: "Asegúrate de que temp ∈ [-5,50] °C y hum ∈ [0,100] % o documenta los rangos."

  - name: "Cifrar datos sensibles"
    description: "No hardcodear passwords, api_key o secrets en código."
    pattern: "(password|api_key|secret)\\s*[:=]\\s*['\\\"][^'\\\"]+['\\\"]"
    severity: "error"
    fix: "Mueve secretos a variables de entorno (por ejemplo, ${ENV_VAR}) o a un vault."

  - name: "Logs con GDPR compliance"
    description: "Evitar PII directa (email, NIF, IBAN) en logs."
    pattern: "logger\\..*(email|nif|iban)"
    language: ["python"]
    severity: "warning"
    fix: "Enmascara PII: logger.info({\"user\": \"[USER_MASKED]\", \"action\": \"...\"})."

  - name: "FastAPI con auth JWT"
    description: "Requerir autenticación en endpoints FastAPI."
    pattern: "@app\\.(get|post|put|delete)\\("
    language: ["python"]
    severity: "warning"
    fix: "Añade dependencies=[Depends(JWTBearer())] o verify_token al decorador del endpoint."

  - name: "VeChain TX en decisiones"
    description: "Recordar registrar decisiones críticas en blockchain."
    pattern: "def sabionda_decide|def ecosistema_b001"
    language: ["python"]
    severity: "info"
    fix: "Incluye hash/tx en el modelo de respuesta y usa vechain_client.log_siex_record(record)."

  - name: "Rate limiting recomendado"
    description: "Sugerir limitador de peticiones por IP."
    pattern: "app = FastAPI"
    language: ["python"]
    severity: "info"
    fix: "Añade un middleware de rate limiting (por ejemplo, slowapi) para 100 req/min por IP."

  - name: "Sanitización de salidas sensibles"
    description: "Evitar devolver password/api_key/secret en respuestas."
    pattern: "return .*password|return .*api_key|return .*secret"
    language: ["python", "javascript", "typescript"]
    severity: "error"
    fix: "Redacta campos sensibles: return {\"status\": \"ok\", \"data\": \"[REDACTED]\"}."

  - name: "TRL9 ISO 27001 A.9.4.4: read_only obligatorio"
    description: "docker-compose castuo-bookstack: read_only: true OBLIGATORIO. Ver docs/legal/TRL9-Cursor-Prompt.md"
    pattern: "read_only:\\s*false"
    path: "**/castuo-bookstack/docker-compose.yml"
    severity: "error"
    fix: "ISO 27001 A.9.4.4 VIOLADO: read_only: true OBLIGATORIO. Restaura read_only: true y ejecuta ./sign-all.sh && ./verify-integrity.sh."

  - name: "TRL9 GDPR Art.32: no-new-privileges obligatorio"
    description: "docker-compose castuo-bookstack: no-new-privileges:true obligatorio. Rechazar no-new-privileges:false o eliminación. Ver docs/legal/TRL9-Cursor-Prompt.md"
    pattern: "no-new-privileges:\\s*false"
    path: "**/castuo-bookstack/**"
    severity: "error"
    fix: "GDPR Art.32 VIOLADO: security_opt no-new-privileges:true requerido. Restaura - no-new-privileges:true en security_opt."

  - name: "TRL9: archivos críticos deben tener *.sig"
    description: "En castuo-bookstack, docker-compose.yml, *.json, *.sh deben tener firma .sig verificable."
    pattern: "docker compose up"
    path: "**/castuo-bookstack/**"
    severity: "warning"
    fix: "Falta *.sig → Ejecutar ./sign-all.sh && ./verify-integrity.sh antes de deploy. Ver TRL9-Cursor-Prompt.md."

