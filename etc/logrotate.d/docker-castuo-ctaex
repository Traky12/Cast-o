# Logrotate para logs CASTUO-CTAEX. Copiar a /etc/logrotate.d/docker-castuo-ctaex
# y ajustar ruta /var/log/castuo si es distinta.

/var/log/castuo/*.log {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    create 0640 root root
    sharedscripts
    postrotate
        systemctl reload rsyslog > /dev/null 2>&1 || true
    endscript
}
