FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app

COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY backend /app/backend

EXPOSE 80
ENV CASTUO_ROBOTICS_LAB_BEARER_TOKEN=""
CMD ["uvicorn", "backend.integrations.robotics.lab_stub_app:app", "--host", "0.0.0.0", "--port", "80"]
