# backend/crypto_master — Master Key Vault 11000
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . /app
RUN pip install --no-cache-dir "cryptography" "fastapi" "uvicorn[standard]"
ENV VAULT_PORT=11000
EXPOSE 11000
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD curl -f http://localhost:11000/health || exit 1
CMD ["python", "-m", "uvicorn", "app_vault:app", "--host", "0.0.0.0", "--port", "11000"]
