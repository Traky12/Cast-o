        "jsCode": "try {\n  // Inicializamos tiempos para el Feedback Loop (sin revelar datos sensibles).\n  const startTime = Date.now();\n  return [{\n    json: {\n      telemetry_in: $json,\n      _zeroLeak_meta: {\n        startTime\n      }\n    }\n  }];\n} catch (e) {\n  // En caso de error interno, marcamos para ruta analoga.\n  return [{ json: { error: String(e), tierra_firme_alert_activado: true } }];\n}\n"
      },
      "name": "ZeroLeak_Init",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.telemetry_in || $json;\n+\n+// Limpieza: solo mantenemos indicadores operativos estrictamente necesarios.\n+// Objetivo: cifrar datos mínimos y preservar soberanía.\n+const sanitized = {\n+  hydrogen_pressure_bar: raw.hydrogen_pressure_bar ?? raw.hydrogen?.pressure_bar ?? null,\n+  biomass_reserve_pct: raw.biomass_reserve_pct ?? raw.biomass?.reserve_pct ?? null,\n+  ph: raw.ph ?? null,\n+  ec_ms_cm: raw.ec_ms_cm ?? null,\n+  timestamp: raw.timestamp ?? raw.ts ?? new Date().toISOString()\n+};\n+\n+// Preparar payload como texto JSON (para backend /encrypt).\n+const dataText = JSON.stringify(sanitized);\n+\n+return [{\n+  json: {\n+    sanitized,\n+    dataText,\n+    _zeroLeak_meta: $json._zeroLeak_meta\n+  }\n+}];\n"
      },
      "name": "ZeroLeak_Sanitize_MinData",
