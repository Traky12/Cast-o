      "parameters": {
        "jsCode": "try {\n  // Heuristica TRL9: si el envío externo falla (status 4xx/5xx) marcamos Modo Isla.\n  const statusCode = $json.statusCode ?? $json.status_code ?? $json.status ?? null;\n  const ok = (statusCode === null) ? true : Number(statusCode) < 400;\n\n  if (!ok) {\n    throw new Error('tierra_firme_alert: falla envio externo (statusCode=' + statusCode + ')');\n  }\n\n  // Feedback Loop anonimo (solo métricas, sin telemetría).\n  const executionTime = Date.now() - ($json._zeroLeak_meta?.startTime || Date.now());\n  const memoryUsed = process.memoryUsage().heapUsed / 1024 / 1024;\n\n  return [{\n    json: {\n      audit: { status: 'ok', encryption: 'backend:/encrypt', isla: false },\n      efficiency_metrics: {\n        ms: executionTime,\n        mb: memoryUsed.toFixed(2)\n      },\n      recommendation_request: 'optimizar_codigo_js'\n    }\n  }];\n} catch (e) {\n  const executionTime = Date.now() - ($json._zeroLeak_meta?.startTime || Date.now());\n  const memoryUsed = process.memoryUsage().heapUsed / 1024 / 1024;\n\n  return [{\n    json: {\n      audit: { status: 'blocked', isla: true, reason: 'tierra_firme_alert' },\n      tierra_firme_alert_activado: true,\n      efficiency_metrics: {\n        ms: executionTime,\n        mb: memoryUsed.toFixed(2)\n      },\n      recommendation_request: 'optimizar_codigo_js'\n    }\n  }];\n}\n"
      },
