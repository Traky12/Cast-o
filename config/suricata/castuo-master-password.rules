# CASTÚO-SYSTEM™ — Reglas Suricata para protección de flujo de contraseña maestra
# Detectan intentos de acceso a endpoints de contraseña maestra y brute force (sin incluir contraseñas reales)

# Detección de intentos de acceso a flujo de contraseña maestra
alert tcp any any -> $HOME_NET any (msg:"CASTUO-Master-Password-Access"; flow:to_server; content:"master_password"; pcre:"/register-master|verify-master|master_key\.hash/i"; threshold:type threshold, track by_src, count 1, seconds 3600; classtype:attempted-admin; sid:3000001; rev:1;)

# Brute force (múltiples intentos en poco tiempo)
alert tcp any any -> $HOME_NET any (msg:"CASTUO-Master-Password-Brute-Force"; flow:to_server; content:"Introduce la contraseña"; threshold:type threshold, track by_src, count 3, seconds 60; classtype:attempted-recon; sid:3000002; rev:1;)

# Acceso a HSM no autorizado (pkcs11-tool --login)
alert tcp any any -> $HOME_NET any (msg:"CASTUO-HSM-Unauthorized-Access"; flow:to_server; content:"pkcs11-tool"; pcre:"/--login|--pin/i"; threshold:type threshold, track by_src, count 1, seconds 3600; classtype:attempted-admin; sid:3000003; rev:1;)
