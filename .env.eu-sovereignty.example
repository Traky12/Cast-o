# Copiar a .env y usar con: docker compose -f docker-compose.eu-sovereignty.yml --env-file .env up -d
# Despliegue real: VPS/región UE + DPA con proveedor.

# --- Soberanía satelital (código: backend/energy_audit/eu_data_sovereignty.py) ---
CASTUO_EU_DATA_SOVEREIGNTY=1
COPERNICUS_USER=
COPERNICUS_PASSWORD=
COPERNICUS_DHUS_BASE=https://scihub.copernicus.eu/dhus

# --- PostgreSQL (docker-compose.eu-sovereignty.yml) ---
POSTGRES_USER=castuo
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=castuo
POSTGRES_PORT=5432
TZ=Europe/Madrid

# --- Backend / apps que lean este .env ---
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://castuo:cambiar_en_produccion@postgres:5432/castuo

# --- GaiaChain (jurisdicción UE en producción) ---
GAIA_CHAIN_RPC_URL=
# GAIA_CHAIN_RPC=
# GAIA_CHAIN_PRIVATE_KEY=

# --- Monitor (docker-compose.monitor.yml) ---
GRAFANA_ADMIN_PASSWORD=cambiar_en_produccion
