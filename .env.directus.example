# Copiar a .env.directus y rellenar (no commitear secretos reales).
# Ver docker-compose.directus.example.yml

DIRECTUS_PORT=8055
DIRECTUS_PUBLIC_URL=http://localhost:8055

DIRECTUS_KEY=
DIRECTUS_SECRET=

DIRECTUS_DB_USER=directus
DIRECTUS_DB_PASSWORD=
DIRECTUS_DB_NAME=directus

DIRECTUS_ADMIN_EMAIL=admin@example.local
DIRECTUS_ADMIN_PASSWORD=

