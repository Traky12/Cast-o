# Plantilla Hetzner / VPS — copiar a .env.castuo-enterprise (no commitear).
# Uso: docker compose -f deploy/docker-compose.castuo.enterprise.example.yml --env-file deploy/.env.castuo-enterprise up -d

# --- PostgreSQL (n8n) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_openssl_rand_hex_16

# --- n8n ---
N8N_ENCRYPTION_KEY=CAMBIA_openssl_rand_hex_24
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_PASSWORD=CAMBIA_password_fuerte
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Madrid

# API CASTÚO (mismo stack Docker)
CASTUO_API_KEY=CAMBIA_clave_compartida_n8n
# Opcional: webhook castuo-orchestrate (workflow castuo_orchestrator_minimal.json)
CASTUO_ORCHESTRATOR_KEY=
CASTUO_ZONE_ID=zone_default
MISTRAL_API_KEY=

# LangSmith / trazas LangChain (sobre todo para ejecuciones Python: LangGraph en castuo-api)
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=CASTUO-AGRI-BRAIN
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# GaiaChain / IPFS / Power BI (opcional, workflows)
N8N_GAIACHAIN_API=
N8N_GAIACHAIN_API_KEY=
GAIACHAIN_REGISTER_URL=
SLACK_WEBHOOK=
CASTUO_LANGGRAPH_URL=

# Versión expuesta en /health
CASTUO_APP_VERSION=enterprise-1.0
