# TEMPLATE — DO NOT COMMIT WITH REAL VALUES
# Apply with: kubectl apply -f secret.yaml -n castuo-system
#
# Generate base64 values:
#   echo -n "your_jwt_secret" | base64
#   echo -n "0xYOUR_PRIVATE_KEY_HEX" | base64
apiVersion: v1
kind: Secret
metadata:
  name: castuo-secrets
type: Opaque
data:
  jwt-secret: BASE64_ENCODED_JWT_SECRET
  gaiachain-private-key: BASE64_ENCODED_GAIACHAIN_PRIVATE_KEY
