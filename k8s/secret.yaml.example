# ⚠️  ESTE FICHERO ES UN EJEMPLO — NO SUBAS LOS VALORES REALES A GIT ⚠️
#
# Crea el secret real con los valores en base64 y aplícalo manualmente:
#
#   echo -n "tu_secreto_jwt"           | base64   →  jwt-secret
#   echo -n "0xCLAVE_PRIVADA_HEX"      | base64   →  gaiachain-private-key
#   echo -n "sk-mistral-xxxxx"         | base64   →  mistral-api-key
#
#   kubectl apply -f k8s/secret.yaml -n castuo-system
#
# Alternativa recomendada (producción): Vault Agent + anotaciones en el pod.
# Ver: infrastructure/vault/policies/quantum.hcl

apiVersion: v1
kind: Secret
metadata:
  name: castuo-secrets
  namespace: castuo-system
  labels:
    app: castuo-api
type: Opaque
data:
  # JWT para autenticación API (POST /api/v1/skills/validar_lote, /api/v1/ai/predict)
  jwt-secret:             BASE64_ENCODED_JWT_SECRET_HERE

  # Clave privada para firmar transacciones GaiaChain
  gaiachain-private-key:  BASE64_ENCODED_GAIACHAIN_PRIVATE_KEY_HERE

  # Clave API Mistral (opcional — si no se configura, usa reglas locales)
  mistral-api-key:        BASE64_ENCODED_MISTRAL_API_KEY_HERE

  # Bearer IoT para telemetría cifrada (opcional)
  castuo-iot-bearer:      BASE64_ENCODED_IOT_BEARER_HERE
