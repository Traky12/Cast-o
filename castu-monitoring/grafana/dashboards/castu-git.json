{
  "title": "CASTUO-SYSTEM™ | Git + BioCoin + Drones + Sensores",
  "uid": "castu-git-dashboard",
  "tags": ["git", "biocoin", "castu", "drones", "iot"],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "title": "Granja (repo)",
      "type": "row",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Commits con TX Hash (Últimas 24h)",
      "type": "table",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "increase(git_commits_total{repo=~\"$finca\", tx_hash!=\"\"}[1d])",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": { "showHeader": true }
    },
    {
      "id": 3,
      "title": "🚨 Commits SIN TX Hash",
      "type": "table",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "git_commits_total{repo=~\"$finca\", tx_hash=\"\"} > 0",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Actividad por Autor",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum by (author) (increase(git_commits_total{repo=~\"$finca\"}[1d]))",
          "legendFormat": "{{author}}",
          "refId": "A"
        }
      ],
      "options": { "orientation": "horizontal" }
    },
    {
      "id": 5,
      "title": "Drones Castuo Link (online)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 7, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "castu_drones_online",
          "refId": "A"
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 6,
      "title": "Batería Drones (Top 5)",
      "type": "table",
      "gridPos": { "x": 18, "y": 7, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "topk(5, castu_drones_battery)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Sensores IoT Temperatura (por granja)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "castu_sensor_temperature{farm=~\"$finca\"}",
          "legendFormat": "{{sensor_id}} ({{farm}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Sensores IoT Humedad",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "castu_sensor_humidity{farm=~\"$finca\"}",
          "legendFormat": "{{sensor_id}} ({{farm}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Merge Conflicts (7d)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "increase(git_merge_conflicts_resolved{repo=~\"$finca\"}[7d])",
          "legendFormat": "{{resolved_by}}",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "finca",
        "label": "Granja",
        "type": "query",
        "datasource": { "type": "prometheus" },
        "query": "label_values(git_commits_total, repo)",
        "regex": "/castu-.*/",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "refresh": "5m",
  "schemaVersion": 38,
  "version": 2,
  "time": { "from": "now-24h", "to": "now" }
}
