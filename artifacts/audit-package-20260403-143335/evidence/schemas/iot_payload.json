{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CASTUO IoT Payload v1.0",
  "type": "object",
  "required": ["sensor_id", "timestamp", "source", "readings"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "sensor_id": {
      "type": "string",
      "minLength": 3
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 2
    },
    "readings": {
      "type": "object",
      "properties": {
        "ph": {"type": "number", "minimum": 0, "maximum": 14},
        "ec_ms_cm": {"type": "number", "minimum": 0, "maximum": 20},
        "vpd_kpa": {"type": "number", "minimum": 0, "maximum": 5}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
