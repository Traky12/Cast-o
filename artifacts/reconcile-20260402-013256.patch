+      - channel: '#alerts'
+        title: '⚠️ HIGH: {{ .GroupLabels.alertname }}'
+        color: 'warning'
+        text: '{{ range .Alerts }}{{ .Annotations.description }}\n{{ end }}'
+
+  - name: 'slack-medium'
+    slack_configs:
+      - channel: '#alerts'
+        title: 'ℹ️ MEDIUM: {{ .GroupLabels.alertname }}'
+        color: '#0099ff'
+        text: '{{ range .Alerts }}{{ .Annotations.description }}\n{{ end }}'
+
+inhibit_rules:
+  # Suppress low priority if high priority exists
+  - source_match:
+      severity: 'high'
+    target_match:
+      severity: 'low'
+    equal: ['alertname', 'cluster', 'service']
+  
+  # Suppress warning if critical exists
+  - source_match:
+      severity: 'critical'
+    target_match:
+      severity: 'warning'
+    equal: ['alertname', 'cluster']
