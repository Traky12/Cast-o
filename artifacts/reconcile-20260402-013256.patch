@@ -0,0 +1,374 @@
+{
+  "name": "Mistral + Sabionda → WordPress Report",
+  "description": "Procesar datos agrícolas con IA (Mistral + Sabionda) y publicar informe en WordPress",
+  "nodes": [
+    {
+      "parameters": {
