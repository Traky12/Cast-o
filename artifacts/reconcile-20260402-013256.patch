+            },
+            {
+              "name": "humidity",
+              "value": "={{$node[\"webhook_trigger\"].json[\"humidity\"]}}"
+            },
+            {
+              "name": "soil_ph",
+              "value": "={{$node[\"webhook_trigger\"].json[\"soil_ph\"]}}"
+            },
+            {
+              "name": "crop",
+              "value": "={{$node[\"webhook_trigger\"].json[\"crop\"] || 'desconocido'}}"
+            },
+            {
+              "name": "location",
+              "value": "={{$node[\"webhook_trigger\"].json[\"location\"] || 'sin especificar'}}"
+            },
+            {
+              "name": "timestamp",
+              "value": "={{$now.toISOString()}}"
+            },
+            {
+              "name": "historical_yield",
+              "value": "={{$node[\"webhook_trigger\"].json[\"historical_yield\"] || []}}"
